{"openapi":"3.0.0","info":{"title":"The OAuth API","description":"The OAuth API provides authentication services for accessing Lattice APIs. It implements the OAuth 2.0\nclient credentials flow, allowing clients to obtain access tokens that can be used for API authorization.","version":"1.0.0","contact":{"name":"Anduril API Support","url":"https://developer.anduril.com","email":"lattice-developers@anduril.com"}},"servers":[{"url":"https://{server}","variables":{"server":{"default":"example.developer.anduril.com","description":"The Lattice server instance to connect to."}}}],"tags":[{"name":"oauth","x-displayName":"OAuth"}],"paths":{"/api/v1/oauth/token":{"post":{"summary":"Get OAuth2 token","description":"Gets a new short-lived token using the specified client credentials","operationId":"getToken","tags":["oauth"],"x-fern-availability":"beta","requestBody":{"required":true,"content":{"application/x-www-form-urlencoded":{"schema":{"type":"object","properties":{"grant_type":{"type":"string","enum":["client_credentials"],"description":"The type of grant being requested","default":"client_credentials","x-fern-type":"literal<\"client_credentials\">"},"client_id":{"type":"string","description":"The client identifier"},"client_secret":{"type":"string","format":"password","description":"The client secret"}},"required":["grant_type"]}}}},"responses":{"200":{"description":"Access token response","content":{"application/json":{"schema":{"type":"object","properties":{"access_token":{"type":"string","description":"The access token"},"token_type":{"type":"string","description":"The type of token (typically \"Bearer\")","example":"Bearer"},"expires_in":{"type":"integer","description":"Lifetime of the access token in seconds","example":3600},"refresh_expires_in":{"type":"integer","description":"Lifetime of the refresh token"},"not-before-policy":{"type":"integer","format":"unix-time","description":"Enforce that a token cannot be used before a specific unixtime"},"scope":{"type":"st